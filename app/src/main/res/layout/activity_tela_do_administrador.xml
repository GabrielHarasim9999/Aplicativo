<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context="CadastroDoPaciente">


    <!-- ================================================= -->
    <!-- BARRA SUPERIOR -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="#CDDDD2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

    </LinearLayout>


    <!-- ================================================= -->
    <!-- CONTEÚDO -->
    <!-- ================================================= -->

    <ScrollView
        android:id="@+id/scrollCadastro"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="25dp"
            android:paddingEnd="25dp"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">


            <!-- ================================================= -->
            <!-- TÍTULO E BOTÃO VOLTAR -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnVoltar"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:backgroundTint="#CDDDD2"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="←"
                    android:textColor="#182235"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Cadastro do Paciente"
                    android:textColor="#182235"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- NOME COMPLETO -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Nome Completo do Paciente"
                android:textColor="#526078"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:gravity="center"
                    android:text="♙"
                    android:textColor="#8CA3C0"
                    android:textSize="21sp" />

                <EditText
                    android:id="@+id/edtNomePaciente"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Nome do paciente"
                    android:inputType="textPersonName"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:text="Lucas de Oliveira Silva"
                    android:textColor="#182235"
                    android:textColorHint="#8CA3C0"
                    android:textSize="15sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- CPF -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="CPF do Paciente"
                android:textColor="#526078"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:gravity="center"
                    android:text="▣"
                    android:textColor="#8CA3C0"
                    android:textSize="18sp" />

                <EditText
                    android:id="@+id/edtCpf"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:inputType="number"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:text="459.281.302-88"
                    android:textColor="#182235"
                    android:textSize="15sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- MÉDICO REQUISITANTE -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Médico Requisitante"
                android:textColor="#526078"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:gravity="center"
                    android:text="♧"
                    android:textColor="#8CA3C0"
                    android:textSize="20sp" />

                <EditText
                    android:id="@+id/edtMedico"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:ellipsize="end"
                    android:inputType="text"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:text="Dr. Mauro Henrique Harasim (CRM 541..."
                    android:textColor="#182235"
                    android:textSize="15sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- EMAIL -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Email do Paciente"
                android:textColor="#526078"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:gravity="center"
                   android:background="@drawable/email"
                    android:textColor="#08751C"
                    android:textSize="20sp" />

                <EditText
                    android:id="@+id/edtEmail"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:inputType="textEmailAddress"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="#182235"
                    android:textSize="15sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- SENHA -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Senha"
                android:textColor="#526078"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:gravity="center"
                    android:background="@drawable/senha"
                    android:textColor="#08751C"
                    android:textSize="18sp" />

                <EditText
                    android:id="@+id/edtSenha"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:inputType="textPassword"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:text="123456789012"
                    android:textColor="#182235"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnMostrarSenha"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="♢"
                    android:textColor="#08751C"
                    android:textSize="22sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- ESQUECEU A SENHA -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/txtEsqueceuSenha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:clickable="true"
                android:focusable="true"
                android:text="Esqueceu a senha?"
                android:textColor="#08751C"
                android:textSize="14sp" />


            <!-- ================================================= -->
            <!-- BOTÃO GERAR QR CODE -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnGerarQrCode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="90dp"
                android:backgroundTint="#08751C"
                android:minHeight="0dp"
                android:text="▦  Gerar e Vincular QR Code"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- ================================================= -->
            <!-- SUPORTE -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Problemas para acessar? "
                    android:textColor="#182235"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtContratarSuporte"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Contratar Suporte"
                    android:textColor="#C8DAD1"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>