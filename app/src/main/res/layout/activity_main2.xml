<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".CodigoGerado">


    <!-- CABEÇALHO -->

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="61dp"
        android:background="#CDDDD2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnVoltar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:backgroundTint="#FFFFFF"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="←"
            android:textColor="#182235"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Código Gerado"
            android:textColor="#182235"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ÁREA VERDE -->

    <LinearLayout
        android:id="@+id/areaVerde"
        android:layout_width="0dp"
        android:layout_height="188dp"
        android:background="#CDDDD2"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardBackgroundColor="#F2FFFA"
            app:cardCornerRadius="50dp"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="✓"
                android:textColor="#00C878"
                android:textSize="25sp"
                android:textStyle="bold" />

        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="Tudo pronto!"
            android:textColor="#182235"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="330dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:text="O QR Code abaixo dá acesso direto aos resultados de:"
            android:textColor="#526078"
            android:textSize="14sp" />

    </LinearLayout>


    <!-- CARTÃO DO QR CODE -->

    <androidx.cardview.widget.CardView
        android:id="@+id/cardQrCode"
        android:layout_width="353dp"
        android:layout_height="350dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="22dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toTopOf="@id/areaVerde"
        app:layout_constraintTop_margin="168dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="24dp">

            <!-- QR CODE -->
            <androidx.cardview.widget.CardView
                android:layout_width="220dp"
                android:layout_height="220dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imgQrCode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="QR Code" />

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/txtNomePaciente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="Lucas de Oliveira Silva"
                android:textColor="#182235"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtExame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Endoscopia Digestiva Alta"
                android:textColor="#1877F2"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Realizado em: 14/10/2026"
                android:textColor="#9BAFC9"
                android:textSize="13sp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <!-- BOTÕES -->

    <LinearLayout
        android:id="@+id/areaBotoes"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/cardQrCode"
        app:layout_constraintTop_margin="74dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnCompartilhar"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:text="☁  Compartilhar"
            android:textAllCaps="false"
            android:textColor="#526078"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btnBaixarPng"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:text="↓  Baixar PNG"
            android:textAllCaps="false"
            android:textColor="#526078"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>


    <Button
        android:id="@+id/btnVoltarInicio"
        android:layout_width="0dp"
        android:layout_height="53dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="58dp"
        android:backgroundTint="#08751C"
        android:text="▣  Voltar para o Início"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>