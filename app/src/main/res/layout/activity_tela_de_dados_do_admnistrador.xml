<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFF"
    tools:context="TelaDeDadosDoAdmnistrador">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="412dp"
        android:layout_height="93dp"
        android:background="#CDDDD2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="32dp">

        <TextView
            android:id="@+id/avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/circle_icon"
            android:gravity="center"
            android:text="DS"
            android:textColor="#11D949"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Olá, bem-vindo"
                android:textColor="#383535"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dr. Mauro Henrique Harasim"
                android:textColor="@color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/circle_icon"
            android:gravity="center"
            android:text="×"
            android:textColor="#2F2D2D"
            android:textSize="25sp" />

    </LinearLayout>

    <ScrollView
    android:id="@+id/contentScroll"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="20dp"
    app:layout_constraintTop_toBottomOf="@+id/header"
    app:latyout_constraitStart_topStartOf="parent"
    app:layout_constraitEnd_toEndOf="parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="0dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:orientation="horizontal"
        android:layout_marginTop="0dp"/>


    <LinearLayout
        android:layout_width="127dp"
        android:layout_height="81dp"
        android:layout_weight="1"
        android:background="@drawable/bg_start_card"
        android:orientation="vertical"
        android:padding="16dp"
        tools:layout_editor_absoluteX="45dp"
        tools:layout_editor_absoluteY="118dp" />

    <TextView
        android:layout_width="74dp"
        android:layout_height="18dp"
        android:text="Exames Hoje"
        android:textColor="#7C7777"
        android:textSize="12sp"
        tools:layout_editor_absoluteX="72dp"
        tools:layout_editor_absoluteY="127dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="14"
        android:textColor="#000000"
        android:textSize="25sp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="72dp"
        tools:layout_editor_absoluteY="152dp" />


    <Space
    android:layout_width="12dp"
    android:layout_height="1dp"/>

    <!-- QR Codes -->

    <LinearLayout
        android:layout_width="134dp"
        android:layout_height="79dp"
        android:layout_weight="1"
        android:background="@drawable/bg_start_card2"
        android:orientation="vertical"
        android:padding="16dp"
        tools:layout_editor_absoluteX="227dp"
        tools:layout_editor_absoluteY="118dp">

        <TextView
            android:layout_width="94dp"
            android:layout_height="17dp"
            android:text="QR Codes Ativos"
            android:textColor="#7C7777"
            android:textSize="12sp" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="182"
            android:textColor="#15871B"
            android:textSize="25sp"
            android:textStyle="bold" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/fundoVerde"
        android:layout_width="340dp"
        android:layout_height="166dp"
        android:background="@drawable/CardVerdeEscuro"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="20dp"
        tools:layout_editor_absoluteX="35dp"
        tools:layout_editor_absoluteY="209dp">


        <LinearLayout
            android:layout_width="41dp"
            android:layout_height="40dp"
            android:background="@drawable/QrCode"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gerar Novo QR Code"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registre o paciente e vincule exames para disponibilizar no QR Code imediatamente"
            android:textColor="#B9D7BB"
            android:textSize="13sp" />

        <TextView
            android:layout_width="62dp"
            android:layout_height="41dp"
            android:layout_weight="1"
            android:gravity="center_vertical|end"
            android:paddingEnd="0dp"
            android:text="→"
            android:textColor="#FFFFFF"
            android:textSize="28sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="412dp"
        android:layout_height="56dp"
        android:background="#CDDDD2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        tools:layout_editor_absoluteX="-1dp"
        tools:layout_editor_absoluteY="433dp" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Exames Recentes"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="403dp"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/black"/>

    <TextView
        android:id="@+id/txtVerTodos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:text="Ver todos"
        android:textColor="#4CAF50"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="340dp"
        tools:layout_editor_absoluteY="403dp" />


</androidx.constraintlayout.widget.ConstraintLayout>


