<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".TelaDeDadosDoAdministrador">

    <!-- ========================= -->
    <!-- HEADER -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="93dp"
        android:background="#CDDDD2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/circle_icon"
            android:gravity="center"
            android:text="DS"
            android:textColor="#11D949"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Olá, bem-vindo"
                android:textColor="#383535"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dr. Mauro Henrique Harasim"
                android:textColor="@color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/circle_icon"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="×"
            android:textColor="#2F2D2D"
            android:textSize="25sp" />

    </LinearLayout>


    <!-- ========================= -->
    <!-- CONTEÚDO COM SCROLL -->
    <!-- ========================= -->

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/navBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="25dp">

            <!-- ========================= -->
            <!-- CARDS DE ESTATÍSTICAS -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="81dp"
                android:orientation="horizontal">

                <!-- EXAMES HOJE -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="81dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_start_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Exames Hoje"
                        android:textColor="#7C7777"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14"
                        android:textColor="#000000"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />


                <!-- QR CODES ATIVOS -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="81dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_start_card2"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QR Codes Ativos"
                        android:textColor="#7C7777"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="182"
                        android:textColor="#15871B"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>


            <!-- ========================= -->
            <!-- ESPAÇO -->
            <!-- ========================= -->

            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp" />


            <!-- ========================= -->
            <!-- GERAR NOVO QR CODE -->
            <!-- ========================= -->

            <LinearLayout
                android:id="@+id/fundoVerde"
                android:layout_width="match_parent"
                android:layout_height="166dp"
                android:background="@drawable/cardverdeescuro"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="41dp"
                    android:layout_height="40dp"
                    android:background="@drawable/qrcode"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gerar Novo QR Code"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Registre o paciente e vincule exames para disponibilizar no QR Code imediatamente"
                    android:textColor="#B9D7BB"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="→"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp" />

            </LinearLayout>


            <!-- ========================= -->
            <!-- ESPAÇO -->
            <!-- ========================= -->

            <Space
                android:layout_width="match_parent"
                android:layout_height="18dp" />


            <!-- ========================= -->
            <!-- EXAMES RECENTES -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Exames Recentes"
                    android:textColor="@color/black"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtVerTodos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Ver todos"
                    android:textColor="#4CAF50"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ========================= -->
            <!-- EXAME ANA BEATRIZ -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="12dp"
                android:background="#CDDDD2"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <!-- ÍCONE -->

                <LinearLayout
                    android:layout_width="27dp"
                    android:layout_height="23dp"
                    android:background="@drawable/bg_exam_card"
                    android:gravity="center"
                    android:orientation="horizontal" />

                <!-- INFORMAÇÕES -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ana Beatriz Ramos"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Colonoscopia"
                        android:textColor="#000000"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hoje, 11:20 • CPF: 123.456.789-10"
                        android:textColor="#9EB0AE"
                        android:textSize="10sp" />

                </LinearLayout>

                <!-- STATUS -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disponível"
                    android:textColor="#15871B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ========================= -->
            <!-- EXAME CARLOS EDUARDO -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="6dp"
                android:background="#CDDDD2"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <!-- ÍCONE -->

                <LinearLayout
                    android:layout_width="31dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_exam_card"
                    android:gravity="center"
                    android:orientation="horizontal" />

                <!-- INFORMAÇÕES -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Carlos Eduardo Santos"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Endoscopia Digestiva Alta"
                        android:textColor="#000000"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hoje, 09:15 • CPF: 987.654.321-00"
                        android:textColor="#9EB0AE"
                        android:textSize="10sp" />

                </LinearLayout>

                <!-- STATUS -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disponível"
                    android:textColor="#15871B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ========================= -->
            <!-- EXAME MARIANA SOUZA LIMA -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="6dp"
                android:background="#CDDDD2"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <!-- ÍCONE -->

                <LinearLayout
                    android:layout_width="31dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_exam_card"
                    android:gravity="center"
                    android:orientation="horizontal" />

                <!-- INFORMAÇÕES -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mariana Souza Lima"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Colonoscopia"
                        android:textColor="#000000"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ontem • CPF: 456.789.123-22"
                        android:textColor="#9EB0AE"
                        android:textSize="10sp" />

                </LinearLayout>

                <!-- STATUS -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Em análise"
                    android:textColor="#B8860B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- ========================= -->
    <!-- BARRA DE NAVEGAÇÃO -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="#CDDDD2"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- HISTÓRICO -->

        <LinearLayout
            android:id="@+id/navHistorico"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="◷"
                android:textColor="#000000"
                android:textSize="27sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Histórico"
                android:textColor="#000000"
                android:textSize="11sp" />

        </LinearLayout>


        <!-- INÍCIO -->

        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="⌂"
                android:textColor="#15871B"
                android:textSize="27sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Início"
                android:textColor="#15871B"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- NOVO EXAME -->

        <LinearLayout
            android:id="@+id/navNovoExame"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="⊕"
                android:textColor="#000000"
                android:textSize="28sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Novo Exame"
                android:textColor="#000000"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>