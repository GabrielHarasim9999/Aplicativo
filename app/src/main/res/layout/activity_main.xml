<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CDDDD2"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/infoArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/loginContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imageLogo"
            android:layout_width="64dp"
            android:layout_height="80dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ImgemMedicina" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <LinearLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/QrCode"
            android:gravity="center" />

        <TextView
            android:id="@+id/textExamiCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ExamiCode"
            android:textColor="#257A50"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Centro Médico"
            android:textColor="#257A50"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/testLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Endoscopia Digestiva"
            android:textColor="#257A50"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:text="Acesso Rápido e seguro a exames médicos via QR"
            android:textColor="#000000" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Code"
            android:textAlignment="center"
            android:textColor="#000000" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="E-mail profissional"
            android:textAlignment="center"
            android:textColor="#000000" />

        <EditText
            android:id="@+id/userName"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:drawableStart="@drawable/Email"
            android:hint="seu@email.com"
            android:inputType="textEmailAddress"
            android:textColor="#257A50" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:text="Senha"
            android:textAlignment="center"
            android:textColor="#000000" />

        <EditText
            android:id="@+id/password"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"
            android:drawableStart="@drawable/senha"
            android:drawableEnd="@drawable/OlhoDeSenha"
            android:hint="Senha"
            android:inputType="textPassword"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/txtEsqueceuSenha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:gravity="end"
            android:text="Esqueceu a senha?"
            android:textColor="#257A50"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonLogin"
            android:layout_width="280dp"
            android:layout_height="80dp"
            android:backgroundTint="#258447"
            android:text="Acessar Sistema"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/ProblemasParaAcessar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="34dp"
            android:gravity="center"
            android:text="Problemas para acessar? Contatar Suporte"
            android:textColor="#000000" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
