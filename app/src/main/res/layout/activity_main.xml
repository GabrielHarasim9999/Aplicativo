<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D3E3D8"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/infoArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/m3_split_button_chevron_avd"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="5dp"
        android:paddingTop="1dp"
        android:paddingBottom="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
         >

        <ImageView
            android:id="@+id/imageLogo"
            android:layout_width="64dp"
            android:layout_height="80dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ImgemMedicina" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp"/>

        <LinearLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:gravity="center"
            android:background="@drawable/QrCode" />
        <TextView
                android:id="@+id/testLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Faça o seu login"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"/>
        <EditText
                android:id="@+id/userName"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:background="@drawable/rouded_edittext"
                android:hint="Usuário"
                android:inputType="textPersonName"
                android:textColor="#000000"
                android:layout_marginBottom="16dp" />
        <EditText
                android:id="@+id/password"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:hint="Senha"
                android:background="@drawable/rouded_edittext"
                android:inputType="textPassword"
                android:textColor="#000000"
                android:layout_marginBottom="16dp" />
        <Button
                android:id="@+id/buttonLogin"
                android:layout_width="280dp"
                android:layout_height="80dp"
                android:text="Entrar"
                android:backgroundTint="#3F8745"
                android:textColor="#FFFFFF"/>
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>